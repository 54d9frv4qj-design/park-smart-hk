# ============================================================
# 泊得好 Park Smart HK — .gitignore
# ============================================================

# --- 數據與模型（執行期產物，不入庫）---
data/*
!data/csv_export/
!data/csv_export/*.csv.gz
!data/raw_csv/
!data/raw_csv/*.csv
models/
output/
*.db
*.sqlite
*.sqlite3
*.pkl
*.joblib
*.parquet

# --- 環境與密碼 ---
.env
.env.local
.streamlit/secrets.toml

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.eggs/

# --- IDE / OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb_checkpoints

# --- 測試與覆蓋率 ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- 日誌 ---
*.log
logs/

# --- Docker ---
docker-compose.override.yml
