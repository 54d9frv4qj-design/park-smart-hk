# ============================================================
# 泊得好 Park Smart HK — 環境變數範例
# 複製為 .env 並填入真實值
# ============================================================

# --- 資料庫 ---
# 本地開發用 SQLite
DATABASE_URL=sqlite:///./data/smart_parking.db
# 生產用 PostgreSQL + TimescaleDB
# DATABASE_URL=postgresql://user:password@localhost:5432/park_smart_hk

# --- 生成式 AI（可選，不設則用規則式建議）---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# 港式繁體中文回應語言
GENAI_LANGUAGE=zh-HK

# --- 政府 API 設定 ---
# 香港政府數據一站通（無需 Token）
DATA_GOV_HK_BASE=https://api.data.gov.hk/v1
# CSDI（如需，需註冊免費帳號取得 Token）
CSDI_TOKEN=
# 請求間隔（秒），避免被限流
API_RATE_LIMIT_SECONDS=1.0

# --- 香港天文台 ---
HKO_BASE=https://data.weather.gov.hk/weatherAPI/opendata

# --- 應用設定 ---
APP_NAME=泊得好 Park Smart HK
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# --- 部署：Streamlit Cloud 必須用 /tmp/ ---
# 因 /mount/src/ 為唯讀，DB 與模型需放在 /tmp/
STREAMLIT_CLOUD_DB_PATH=/tmp/smart_parking.db
STREAMLIT_CLOUD_MODEL_DIR=/tmp/models

# --- 排程 ---
# App 內每 10 分鐘檢查刷新
REFRESH_INTERVAL_MINUTES=10
# GitHub Actions 每小時同步
SYNC_INTERVAL_HOURS=1
